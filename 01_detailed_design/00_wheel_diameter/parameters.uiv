[version]
format: 0.1.1
unit_frame: derived.ut

# --------------------------------------------------------------------

[note]
application: "Sizes a wheels diameter via parametric modelling"
description: "Generates a wheel diameter vs speed table"

# --------------------------------------------------------------------

[numerics]
diameter_step: 5 m(m)

# ----------------------------

[req]
max_diameter: 130 m(m)
min_diameter: 80 m(m)

max_speed: 0.07 (m*s^-1)
min_speed: 0.041 (m*s^-1)

# ----------------------------

[drivetrain]
max_frequency: 0.167 (s^-1)

# ----------------------------